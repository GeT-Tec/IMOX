# IMOX FastAPI Backend - Environment Template
# NUNCA comitar este arquivo preenchido (.env é ignorado pelo Git)
SUPABASE_URL=https://kbnyesbkmablickwcwfw.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_restrita_ao_backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vertical 03 - Integração ONR / SAEC
STORAGE_BUCKET_DOCUMENTOS=documentos_oficiais
ONR_MOCK_MODE=true
ONR_API_BASE_URL=https://api-homologacao.onr.example
ONR_API_KEY=
# Segredo compartilhado exigido no header X-ONR-Webhook-Secret (gere um valor aleatório longo)
ONR_WEBHOOK_SECRET=
ONR_TIMEOUT_SECONDS=30
# Hosts autorizados para download do PDF retornado (separados por vírgula)
ONR_ALLOWED_DOCUMENT_HOSTS=
# URL pública desta API (usada como url_retorno enviada ao ONR)
PUBLIC_API_BASE_URL=http://localhost:8000
